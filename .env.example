# Copy to .env (not versioned) and adjust. flash_all.sh reads it.

# Serial port; empty = esptool autodetects it (e.g. /dev/tty.usbmodem1101).
WATCH_PORT=

# Apps to put on the watch, from apps.conf, space separated. Empty = all of them.
# Apps left out have their slot emptied on a full ./flash_all.sh (and Doom's WAD is
# not flashed), so the launcher does not show them.
APPS=

# App repos (<NAME>_DIR for each app in apps.conf), relative to this repo or absolute.
# Unset = the dir in apps.conf.
# MAZE_DIR=../ESP32Watch-Maze
# DOOM_DIR=../ESP32Watch-Doom
# FLUID_DIR=../ESP32Watch-Fluid
